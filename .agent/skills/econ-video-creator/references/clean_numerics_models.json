{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Standardized integer economics models for EconLab animated explainer videos.",
  "models": {
    "tax_and_deadweight_loss": {
      "topic": "Specific Commodity Tax and Deadweight Loss",
      "demand": "P = 100 - Q",
      "supply": "P = 10 + Q",
