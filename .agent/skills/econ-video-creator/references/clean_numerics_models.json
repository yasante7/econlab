        "consumer_tax_incidence": 10,
        "producer_tax_incidence": 10
      },
      "geometry_points": {
        "pre_eq": [45, 55],
        "post_eq_buyer": [35, 65],
        "post_eq_seller": [35, 45],
        "dwl_triangle": [[35, 65], [35, 45], [45, 55]],
        "tax_revenue_rect": [[0, 45], [35, 45], [35, 65], [0, 65]]
      }
    },
    "price_ceiling_rent_control": {
