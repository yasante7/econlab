      "tax_per_unit": 20,
      "supply_post_tax": "P = 30 + Q",
      "equilibrium_post_tax": {
        "Q": 35,
        "P_buyer": 65,
        "P_seller": 45
      },
      "welfare": {
        "tax_revenue": 700,
